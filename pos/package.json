{
  "name": "pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "preview": "ng serve --configuration production",
    "tipos": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "formato": "prettier --check .",
    "formato:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run formato && npm run lint && npm run tipos && npm run test",
    "build:demo": "ng build --configuration demo"
  },
  "dependencies": {
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/router": "^20.3.33",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.39",
    "@angular/cli": "^20.3.39",
    "@angular/compiler-cli": "^20.3.33",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.7",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
